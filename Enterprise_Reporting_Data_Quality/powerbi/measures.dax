Records = COUNTROWS('validated_reporting_records')
Metric Total = SUM('validated_reporting_records'[metric_value])
Distinct Employees = DISTINCTCOUNT('validated_reporting_records'[employee_id])
Source Systems = DISTINCTCOUNT('validated_reporting_records'[source_system])
Exception Rows = COUNTROWS('data_quality_exceptions')
Duplicate Exceptions = CALCULATE([Exception Rows], 'data_quality_exceptions'[issue_code]="DUPLICATE_RECORD_ID")
Unknown Employee Exceptions = CALCULATE([Exception Rows], 'data_quality_exceptions'[issue_code]="UNKNOWN_EMPLOYEE")
Missing Date Exceptions = CALCULATE([Exception Rows], 'data_quality_exceptions'[issue_code]="MISSING_RECORD_DATE")
Invalid Metric Exceptions = CALCULATE([Exception Rows], 'data_quality_exceptions'[issue_code]="INVALID_METRIC_VALUE")
Quality Pass Rate = DIVIDE([Records], [Records]+[Exception Rows], 0)
Records Pending Review = CALCULATE([Records], 'validated_reporting_records'[status] IN {"Pending","Open"})
